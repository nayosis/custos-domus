# Réglages facultatifs : copier en .env (jamais versionné) à côté de docker-compose.yml.

# Port de la machine hôte (3000 par défaut).
# CUSTOS_PORT=3000

# Version de l'image (latest par défaut), par exemple 0.2 pour rester sur les mises à jour 0.2.x.
# CUSTOS_VERSION=latest

# Administrateur principal défini ici plutôt qu'à l'écran au premier lancement.
# Son mot de passe est remis à jour au démarrage s'il change ici.
# SUPER_ADMIN_EMAIL=vous@exemple.fr
# SUPER_ADMIN_MOT_DE_PASSE=une-longue-phrase-secrete

# Hors Docker : dossier des données et port d'écoute.
# DOSSIER_DONNEES=./data
# PORT=3210
